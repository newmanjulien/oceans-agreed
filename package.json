{
	"name": "agreed",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": ">=22.12.0"
	},
	"allowScripts": {
		"esbuild@0.27.0": true,
		"esbuild@0.28.2": true,
		"fsevents@2.3.3": true
	},
	"scripts": {
		"dev": "vite dev",
		"build": "node scripts/clean-vercel-output.mjs && npm run check && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test:perf": "vitest run --config vitest.config.ts",
		"verify": "npm run test:perf && npm run build",
		"seed:restore-export": "node scripts/production-seed.mjs",
		"seed:reconcile": "node scripts/reconcile-production-seed.mjs",
		"seed:verify": "node scripts/verify-seed-data.mjs",
		"convex:seed": "npm run seed:verify && node scripts/seed-convex.mjs",
		"db:audit": "node scripts/audit-convex.mjs",
		"format": "prettier --write src scripts",
		"format:check": "prettier --check src scripts"
	},
	"dependencies": {
		"@clerk/backend": "^3.23.0",
		"@clerk/shared": "4.39.0",
		"@floating-ui/dom": "^1.8.0",
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource/newsreader": "^5.3.0",
		"clsx": "^2.1.1",
		"convex": "^1.46.0",
		"convex-svelte": "^0.14.0",
		"docx": "^9.8.1",
		"nodemailer": "^10.0.15",
		"phosphor-svelte": "^3.1.0",
		"svelte-clerk": "^1.2.0",
		"svix": "^2.7.0",
		"tailwind-merge": "^3.7.0"
	},
	"devDependencies": {
		"@edge-runtime/vm": "^5.0.0",
		"@sveltejs/adapter-vercel": "^6.3.3",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^22.0.0",
		"convex-test": "^0.0.60",
		"fake-indexeddb": "^6.2.5",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^5.0.3"
	},
	"overrides": {
		"@sveltejs/kit": {
			"cookie": "0.7.2"
		}
	}
}
