# Run `npx convex dev` to create a development deployment and generate these values.
CONVEX_DEPLOYMENT=dev:your-deployment-name
PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# Clerk development application (the secret is used only by SvelteKit's server).
PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Configure these separately on the matching Convex backend:
# CLERK_SECRET_KEY=<same development application's secret key>
# CLERK_JWT_ISSUER_DOMAIN=https://<your-development-app>.clerk.accounts.dev
# CLERK_WEBHOOK_SIGNING_SECRET=whsec_...
# APP_URL=http://localhost:5173
# See docs/clerk-auth.md for JWT claims, webhook setup, and rollout.

# Approval email values belong on the Convex backend, not in frontend env files.
# Configure using `npx convex env set NAME value` on the intended deployment:
# APPROVAL_EMAIL=ben@oceanstalent.com
# SMTP_USER=julien.newman@gmail.com
# SMTP_APP_PASSWORD=<Gmail app password; credential setup deferred>
# APP_URL=https://<live-app-origin; deferred>
